{
    "compilerOptions": {
        "module": "nodenext",
        "target": "es2023",
        "lib": [
            "ES2023"
        ],
        "types": [],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "strict": true,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true,
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "~b/*": [
                "packages/backend/src/*"
            ],
            "~utils/*": [
                "utils/*"
            ],
            "~prisma/*": [
                "generated/prisma/*"
            ],
            "~shared/*": [
                "packages/shared/src/*"
            ]
        }
    }
}
