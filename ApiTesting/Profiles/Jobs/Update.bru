meta {
  name: Update
  type: http
  seq: 5
}

put {
  url: {{BASE_URL}}/profiles/:profile_id/jobs/:job_id
  body: json
  auth: inherit
}

params:path {
  job_id: 489dbc4e-35a5-4d76-80fe-c8d36debfb4f
  profile_id: 886e937a-a5d9-4b80-b569-4ee672b28bec
}

body:json {
  {
    "generations": 100,
    "population": 100,
    "max_size": 15,
    "number_of_tournaments": 3,
    "crossover_probability": 0.9,
    "mutation_probability": 0.3,
    "non_terminals": [
      "add",
      "sub",
      "mul",
      "div",
      "sin"
    ],
    "loss": "MSE",
    "optimization_iterations": 50,
    "optimization_repeats": 2,
    "max_param_count": -1,
    "split": 1,
    "simplify": false
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
