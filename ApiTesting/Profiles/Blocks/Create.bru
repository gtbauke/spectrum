meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/profiles/:profile_id/blocks
  body: json
  auth: inherit
}

params:path {
  profile_id: 886e937a-a5d9-4b80-b569-4ee672b28bec
}

body:json {
  [
    {
      "order_index": 1,
      "data": {
        "kind": "markdown",
        "data": "# This is my markdown content"
      }
    },
    {
      "order_index": 2,
      "data": {
        "kind": "inference",
        "data": "SELECT * FROM my_model LIMIT 10"
      }
    }
  ]
}

settings {
  encodeUrl: true
  timeout: 0
}
